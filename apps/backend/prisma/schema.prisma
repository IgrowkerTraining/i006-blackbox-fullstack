// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

generator zod {
  provider = "zod-prisma-types"
  output   = "../generated/zod"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id          String   @id @default(uuid())
  name        String
  usdotNumber String?
  state       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // relaciones
  vehicles           Vehicle[]
  drivers            Driver[]
  users              User[]
  operational_events OperationalEvent[]
}

model Vehicle {
  id          String  @id @default(uuid())
  companyId   String
  driverId    String? @unique
  unit_number String?
  plate       String?
  is_active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relaciones
  company Company @relation(fields: [companyId], references: [id]) // relacion 1:M por companyId

  driver Driver? @relation(fields: [driverId], references: [id]) // relacion 1:1 por driverId

  operational_events OperationalEvent[]
}

model Driver {
  id             String   @id @default(uuid())
  companyId      String
  name           String
  license_number String
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  // relaciones
  company            Company            @relation(fields: [companyId], references: [id])
  vehicle            Vehicle?
  operational_events OperationalEvent[]
}

model User {
  id                   String    @id @default(uuid())
  companyId            String
  name                 String
  email                String    @unique
  passwordHash         String
  role                 UserRole  @default(OPERATOR)
  isActive             Boolean   @default(true)
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime  @default(now())

  company            Company            @relation(fields: [companyId], references: [id])
  operational_events OperationalEvent[]

  @@unique([id, companyId])
}

// Enums para eventos operacionales
enum EventType {
  UNKNOWN
  ACCIDENT
  MAINTENANCE
  INSPECTION
  OTHER
}

enum LocationType {
  UNKNOWN
  GPS
  ADDRESS
}

enum ContextType {
  UNKNOWN
  MANUAL
  AUTOMATIC
  SENSOR
}

enum GeneralResult {
  WITH_OBS
  WITHOUT_OBS
}

// Severidad de eventos usado principalmente para accidentes y mantenimiento crítico
// Permite filtrar eventos por gravedad para reportes de compliance y alertas
enum EventSeverity {
  MINOR     // Incidentes menores, mantenimiento rutinario
  MODERATE  // Requiere atención pero no es urgente
  SEVERE    // Requiere atención inmediata
  CRITICAL  // Emergencia, peligro inminente
}

model OperationalEvent {
  id                 String         @id @default(uuid())
  company_id         String
  vehicle_id         String?
  driver_id          String?
  event_type         EventType
  event_datetime     DateTime
  location           LocationType?
  context            ContextType?
  general_result     GeneralResult?

  // Estos campos permiten generar reportes de compliance, filtrar eventos críticos,
  // y crear alertas automáticas sin necesidad de parsear JSON
  
  severity           EventSeverity? // Gravedad del evento para filtrar accidentes graves y priorizar atención
  cost               Decimal?       // Costo del evento (mantenimiento/reparación) necesario para reportes financieros
  mileage            Int?           // Kilometraje al momento del evento tracking de mantenimiento preventivo (en millas supongo)
  next_service_date  DateTime?      // Próxima fecha de servicio para generar alertas de mantenimiento vencido
  injuries_reported  Boolean?       // Si hubo lesiones, para compliance y reportes regulatorios


  e_signature        String?
  final_observations String? // JSON con detalles adicionales específicos por tipo de evento
  is_confirmed       Boolean?
  created_by_user_id String
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  company   Company  @relation(fields: [company_id], references: [id])
  vehicle   Vehicle? @relation(fields: [vehicle_id], references: [id])
  driver    Driver?  @relation(fields: [driver_id], references: [id])
  createdBy User     @relation(fields: [created_by_user_id], references: [id])

  inspection_details InspectionDetail[]

  // Índices para mejorar performance en queries de reportes
  @@index([company_id, event_type])
  @@index([company_id, event_datetime])
  @@index([company_id, severity])
  @@index([vehicle_id])
  @@index([driver_id])
  @@index([next_service_date])
}

enum TypeInspection {
  ARRIVAL
  DEPARTURE
}

enum InspectionStatus {
  ACCEPTABLE
  NOT_ACCEPTABLE
}

model InspectionDetail {
  id                     String            @id @default(uuid())
  event_id               String
  type_inspection        TypeInspection?
  documentation_verified Boolean?
  vehicle_condition      InspectionStatus?
  lights_ok              Boolean?
  tires_ok               Boolean?
  brakes_ok              Boolean?
  safety_elements_ok     Boolean?

  event OperationalEvent @relation(fields: [event_id], references: [id])
}

enum UserRole {
  ADMIN
  OPERATOR
  COMPLIANCE
}