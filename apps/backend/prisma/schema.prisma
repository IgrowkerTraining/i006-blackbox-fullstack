generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Companies {
  id          String   @id @default(uuid())
  name        String?
  usdotNumber String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // relaciones
  vehicles Vehicles[] // una compañía tiene muchos vehículos
}

model Vehicles {
  id          String  @id @default(uuid())
  companyId   String
  unit_number String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relaciones
  company Companies @relation(fields: [companyId], references: [id]) // relacion 1:M por companyId
}
