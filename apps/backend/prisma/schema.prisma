// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id           String   @id @default(uuid())
  name         String
  usdotNumber  String
  state        String //faltaba este campo
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // relaciones
  vehicles Vehicle[] // una compañía tiene muchos vehículos
  drivers  Driver[] // una compañía tiene muchos drivers
  users    User[]
  operational_events OperationalEvent[]
}

model Vehicle {
  id          String  @id @default(uuid())
  companyId   String
  driverId    String? @unique
  unit_number String?
  plate       String?
  is_active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relaciones
  company Company @relation(fields: [companyId], references: [id]) // relacion 1:M por companyId
  
  driver   Driver? @relation(fields: [driverId], references: [id]) // relacion 1:1 por driverId

  operational_events OperationalEvent[]
}

model Driver {
  id             String   @id @default(uuid())
  companyId      String
  name           String
  license_number String
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  // relaciones
  company Company  @relation(fields: [companyId], references: [id])
  vehicle Vehicle?

  operational_events OperationalEvent[]
}

model User {
  id           String   @id @default(uuid())
  companyId    String
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(OPERATOR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  
  @@unique([id, companyId])
  operational_events OperationalEvent[]
}

// Enums para eventos operacionales. Ajustar valores según dominio.
enum EventType {
  UNKNOWN
  ACCIDENT
  MAINTENANCE
  INSPECTION
  OTHER
}

enum LocationType {
  UNKNOWN
  GPS
  ADDRESS
}

enum ContextType {
  UNKNOWN
  MANUAL
  AUTOMATIC
  SENSOR
}

enum GeneralResult {
  WITH_OBS
  WITHOUT_OBS
}

model OperationalEvent {
  id                  String        @id @default(uuid())
  company_id          String
  vehicle_id          String?
  driver_id           String?
  event_type          EventType
  event_datetime      DateTime
  location            LocationType?
  context             ContextType?
  general_result      GeneralResult?
  e_signature         String?
  final_observations  String?
  is_confirmed        Boolean?
  created_by_user_id  String
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt

  company Company @relation(fields: [company_id], references: [id])
  vehicle Vehicle? @relation(fields: [vehicle_id], references: [id])
  driver  Driver?  @relation(fields: [driver_id], references: [id])
  createdBy User @relation(fields: [created_by_user_id], references: [id])
}

enum UserRole {
  ADMIN      
  OPERATOR 
  COMPLIANCE 
}